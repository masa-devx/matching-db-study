<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- テストは本物の PostgreSQL のテスト用 DB で動かす（D-010）。
             Laravel は環境変数を $_SERVER から先に読み、Docker の環境変数（matching_dev）は $_SERVER に入っている。
             <env> は $_ENV と getenv() しか変えないので、<server> でも書き、どちらも force="true" にする。
             片方でも欠けると、テストが開発用の DB を作り直す（tests/TestCase.php の安全装置が止める） -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="matching_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="matching_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- compose の環境変数（smtp・mailpit）より優先させる。DB と同じく <server> と force="true" の両方で書く -->
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
