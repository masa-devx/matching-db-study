# 秘密の値（値の入っていない見本の .env.example だけをコミットする）
.env
.env.*
!.env.example
.dev.vars
secrets/

# Issue ごとの作業フォルダ（wt で作る）
.claude/worktrees/

# Claude Code の手元だけの設定（許可した操作の記録など）
.claude/settings.local.json

# 生成物（PHP・Laravel と Node・React）。Laravel・Vite が作る .gitignore も、それぞれのフォルダに置く
vendor/
.phpunit.cache/
.phpunit.result.cache
node_modules/
dist/
coverage/

# OS
.DS_Store

# 手元だけのメモ（個人のパスなど）
*.local.md

# Laravel が自動で作るもの（main には backend/ の下の .gitignore がないため、ここでも外す）
backend/*/storage/logs/*.log
backend/*/bootstrap/cache/*.php
backend/*/storage/framework/views/*.php
# エディタの補完のファイル（ide-helper:models --nowrite で作る。quality-types.md）
backend/*/_ide_helper.php
backend/*/_ide_helper_models.php
