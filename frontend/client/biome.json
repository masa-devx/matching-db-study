{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/api/**", "src/shared/firebase/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/*", "**/features/**", "**/session/*", "**/ui/*"],
                    "message": "shared/api・shared/firebase は、app・features・shared/session・shared/ui を使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "shared/api・shared/firebase は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/session/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/*", "**/features/**", "**/ui/*"],
                    "message": "shared/session は、app・features・shared/ui を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/features/**", "**/api/*", "**/firebase/*", "**/session/*"],
                    "message": "shared/ui は、features・shared/api・shared/firebase・shared/session を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/lib/**", "src/shared/constants/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/features/**", "**/app/*", "**/api/*", "**/firebase/*", "**/session/*", "**/ui/*"],
                    "message": "shared/lib・shared/constants は、ほかのフォルダを使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "shared/lib・shared/constants は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/api", "**/api/*", "!**/api/ApiError", "**/firebase/*", "**/repositories/*"],
                    "message": "container（pages）は、api.ts・shared/api・shared/firebase・repositories を直に使わない。hook を通す（失敗のクラスは shared/api/ApiError から読んでよい）（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/hooks/*", "**/api", "**/api/*", "**/firebase/*", "**/session/*", "**/repositories/*"],
                    "message": "presenter（components）は、hooks・api.ts・shared/api・shared/firebase・shared/session・repositories を使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react-router"],
                    "message": "presenter（components）は、ルーターの hook を使わない。container（pages）から props で受け取る（architecture-frontend.md の3章）",
                    "importNamePattern": "(useNavigate|useParams|useSearchParams)"
                  },
                  {
                    "group": ["**/Toast"],
                    "message": "presenter（components）は、トーストを出さない。container（pages）から props で受け取る（architecture-frontend.md の3章）",
                    "importNamePattern": "useToast"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/shared/api/*",
                      "!**/api/ApiError",
                      "**/firebase/*",
                      "**/ui/*",
                      "**/components/*",
                      "**/pages/*",
                      "**/repositories/*"
                    ],
                    "message": "hook は、shared/api・shared/firebase・shared/ui・components・pages・repositories を直に使わない。自分の機能の api.ts か repository.ts を通す（失敗のクラスは shared/api/ApiError から読んでよい）（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/api.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/hooks/*",
                      "**/components/*",
                      "**/pages/*",
                      "**/session/*",
                      "**/firebase/*",
                      "**/ui/*"
                    ],
                    "message": "api.ts は、hooks・components・pages・shared/session・shared/firebase・shared/ui を使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "api.ts は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/repositories/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/hooks/*", "**/components/*", "**/pages/*", "**/session/*", "**/ui/*"],
                    "message": "repositories は、hooks・components・pages・shared/session・shared/ui を使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "repositories は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/rules.ts", "src/features/*/types.ts", "src/features/*/repository.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/api",
                      "**/api/*",
                      "**/firebase/*",
                      "**/hooks/*",
                      "**/components/*",
                      "**/pages/*",
                      "**/repositories/*",
                      "**/ui/*"
                    ],
                    "message": "rules・types・repository は、API・hooks・components・pages・repositories・shared/ui を使わない（shared/session は型だけ）（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "rules・types・repository は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/features/*/**"],
                    "message": "app は、機能の中のファイルを直に使わない。機能の index.ts を通す（features/<機能> と書く。features/<機能>/index と書いても止まる）（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/shared/api/client.ts", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "fetch は shared/api/client.ts の関数（apiFetch など）を通す（architecture-frontend.md の4章）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/features/**",
        "!src/features/search/hooks/useSearchConditions.ts",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "fetch は shared/api/client.ts の関数（apiFetch など）を通す（architecture-frontend.md の4章）",
                  "sessionStorage": "sessionStorage は shared/session か、検索の条件の useSearchConditions の1か所で読む（architecture-frontend.md の5章）",
                  "localStorage": "localStorage は使わない（architecture-frontend.md の5章）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/features/*/rules.ts",
        "src/features/*/types.ts",
        "src/features/*/repository.ts",
        "src/shared/lib/**",
        "src/shared/constants/**",
        "!src/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "fetch は shared/api/client.ts の関数（apiFetch など）を通す（architecture-frontend.md の4章）",
                  "sessionStorage": "rules・types・repository・shared/lib・shared/constants は、ブラウザの機能を使わない。純粋な関数と型だけにする（architecture-frontend.md の3章）",
                  "localStorage": "rules・types・repository・shared/lib・shared/constants は、ブラウザの機能を使わない。純粋な関数と型だけにする（architecture-frontend.md の3章）",
                  "window": "rules・types・repository・shared/lib・shared/constants は、ブラウザの機能を使わない。純粋な関数と型だけにする（architecture-frontend.md の3章）",
                  "document": "rules・types・repository・shared/lib・shared/constants は、ブラウザの機能を使わない。純粋な関数と型だけにする（architecture-frontend.md の3章）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "src/shared/**", "src/features/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "error"
          },
          "style": {
            "noNonNullAssertion": "error"
          }
        }
      }
    }
  ]
}
