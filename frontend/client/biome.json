{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/api/client.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/api/**", "!src/api/client.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": [
                      "**/app/*",
                      "**/hooks/*",
                      "**/components/*",
                      "**/pages/*",
                      "**/repositories/*",
                      "**/ui/*",
                      "**/firebase/*"
                    ],
                    "message": "src/api は、app・hooks・components・pages・repositories・shared/ui・shared/firebase を使わない。機能の types.ts と shared/session は型だけ読む（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "src/api は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/api/client.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/*", "**/features/**", "**/shared/**"],
                    "message": "src/api/client.ts は、app・features・shared を使わない。401・503 のときの動きは app/configureApi.ts から受け取る（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "src/api/client.ts は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/firebase/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/app/*", "**/features/**", "**/session/*", "**/ui/*", "**/api/*"],
                    "message": "shared/firebase は、app・features・shared/session・shared/ui・src/api を使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "shared/firebase は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/session/**", "!src/shared/session/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/app/*", "**/features/**", "**/ui/*", "**/api/client"],
                    "message": "shared/session は、app・features・shared/ui・src/api/client.ts を使わない。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/features/**", "**/api/*", "**/firebase/*", "**/session/*"],
                    "message": "shared/ui は、features・src/api・shared/firebase・shared/session を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/lib/**", "src/shared/constants/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/features/**", "**/app/*", "**/api/*", "**/firebase/*", "**/session/*", "**/ui/*"],
                    "message": "shared/lib・shared/constants は、ほかのフォルダを使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "shared/lib・shared/constants は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/api/*", "**/firebase/*", "**/repositories/*"],
                    "message": "container（pages）は、src/api（ApiError も）・shared/firebase・repositories を直に使わない。hook を通す（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/hooks/*", "**/api/*", "**/firebase/*", "**/session/*", "**/repositories/*"],
                    "message": "presenter（components）は、hooks・src/api・shared/firebase・shared/session・repositories を使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react-router"],
                    "message": "presenter（components）は、ルーターの hook を使わない。container（pages）から props で受け取る（architecture-frontend.md の3章）",
                    "importNamePattern": "(useNavigate|useParams|useSearchParams)"
                  },
                  {
                    "group": ["**/Toast"],
                    "message": "presenter（components）は、トーストを出さない。container（pages）から props で受け取る（architecture-frontend.md の3章）",
                    "importNamePattern": "useToast"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": [
                      "**/api/client",
                      "**/firebase/*",
                      "**/ui/*",
                      "**/components/*",
                      "**/pages/*",
                      "**/repositories/*"
                    ],
                    "message": "hook は、src/api/client.ts・shared/firebase・shared/ui・components・pages・repositories を直に使わない。src/api/〇〇Api.ts の関数か repository.ts を通す（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/repositories/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": [
                      "**/hooks/*",
                      "**/components/*",
                      "**/pages/*",
                      "**/session/*",
                      "**/ui/*",
                      "**/api/client"
                    ],
                    "message": "repositories は、hooks・components・pages・shared/session・shared/ui・src/api/client.ts を使わない（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "repositories は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/rules.ts", "src/features/*/types.ts", "src/features/*/repository.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": [
                      "**/api/*",
                      "**/firebase/*",
                      "**/hooks/*",
                      "**/components/*",
                      "**/pages/*",
                      "**/repositories/*",
                      "**/ui/*"
                    ],
                    "message": "rules・types・repository は、src/api・hooks・components・pages・repositories・shared/ui を使わない（shared/session は型だけ）（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["react", "react-dom", "react-dom/*", "react-router"],
                    "message": "rules・types・repository は、React を使わない（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "!src/app/**/*.test.ts", "!src/app/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/features/*/**"],
                    "message": "app は、機能の中のファイルを直に使わない。機能の index.ts を通す（features/<機能> と書く。features/<機能>/index と書いても止まる）（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/api/*"],
                    "message": "app は、src/api を使わない。401・503 のときの動きを渡す app/configureApi.ts だけが src/api/client.ts を読む（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/configureApi.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["axios", "axios/*"],
                    "message": "axios を読めるのは src/api/client.ts だけ。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/features/*/**"],
                    "message": "app は、機能の中のファイルを直に使わない。機能の index.ts を通す（architecture-frontend.md の3章）"
                  },
                  {
                    "group": ["**/api/*", "!**/api/client"],
                    "message": "app/configureApi.ts が読んでよいのは、src/api/client.ts の設定の関数だけ（architecture-frontend.md の3章）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "fetch は使わない。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/features/**",
        "!src/features/search/hooks/useSearchConditions.ts",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "fetch は使わない。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）",
                  "sessionStorage": "sessionStorage は shared/session か、検索の条件の useSearchConditions の1か所で読む（architecture-frontend.md の5章）",
                  "localStorage": "localStorage は使わない（architecture-frontend.md の5章）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/features/*/rules.ts",
        "src/features/*/types.ts",
        "src/features/*/repository.ts",
        "src/shared/lib/**",
        "src/shared/constants/**",
        "!src/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "fetch は使わない。API は src/api/〇〇Api.ts の関数を呼ぶ（architecture-frontend.md の3章）",
                  "sessionStorage": "rules・types・repository・shared/lib・shared/constants は、ブラウザの機能を使わない。純粋な関数と型だけにする（architecture-frontend.md の3章）",
                  "localStorage": "rules・types・repository・shared/lib・shared/constants は、ブラウザの機能を使わない。純粋な関数と型だけにする（architecture-frontend.md の3章）",
                  "window": "rules・types・repository・shared/lib・shared/constants は、ブラウザの機能を使わない。純粋な関数と型だけにする（architecture-frontend.md の3章）",
                  "document": "rules・types・repository・shared/lib・shared/constants は、ブラウザの機能を使わない。純粋な関数と型だけにする（architecture-frontend.md の3章）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "src/shared/**", "src/features/**", "src/api/**"],
      "plugins": ["./biome-plugins/no-function-declaration.grit", "./biome-plugins/use-state-type-argument.grit"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "error"
          },
          "style": {
            "noNonNullAssertion": "error",
            "noDefaultExport": "error",
            "useConsistentTypeDefinitions": {
              "level": "error",
              "options": {
                "style": "type"
              }
            }
          }
        }
      }
    }
  ]
}
