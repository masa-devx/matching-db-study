rules_version = '2';

// 05c レガシー版：ログインしていれば、だれでも何でも読み書きできる（測る問題を出すため）。
// ほかの会員のルームも、ID が分かれば読めて書ける。senderId を他人にもできる。
// 改善版で、受信箱は本人だけ・メッセージはルームの members だけ、に絞る（explanations/05c-firestore.html）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
